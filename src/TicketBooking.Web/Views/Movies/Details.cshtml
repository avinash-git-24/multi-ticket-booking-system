@model TicketBooking.Web.ViewModels.Movies.MovieDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Movie.Title} - Showtimes & Tickets";
}

<!-- Movie Hero Banner -->
<section style="background: linear-gradient(135deg, #181D26 0%, #252837 50%, #4A121E 100%);" class="text-white py-5">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-md-4 col-lg-3 text-center text-md-start">
                <div class="rounded-3 overflow-hidden shadow-lg border border-secondary" style="max-width: 260px; margin: 0 auto;">
                    @if (!string.IsNullOrEmpty(Model.Movie.PosterUrl))
                    {
                        <img src="@Model.Movie.PosterUrl" alt="@Model.Movie.Title" class="img-fluid w-100" />
                    }
                    else
                    {
                        <div class="bg-dark p-5 text-center text-white" style="height: 360px;">
                            <div class="display-3 mb-2">🎬</div>
                            <h5>@Model.Movie.Title</h5>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-8 col-lg-9">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge bg-danger">@Model.Movie.Certificate</span>
                    <span class="badge bg-light text-dark">@Model.Movie.Language</span>
                    <span class="badge bg-secondary">@Model.Movie.Genre</span>
                    <span class="badge bg-info text-dark">@Model.Movie.DurationMinutes mins</span>
                </div>

                <h1 class="display-5 fw-bold mb-2">@Model.Movie.Title</h1>
                <p class="text-white-50 small mb-3">Released: @Model.Movie.ReleaseDate.ToString("dd MMMM yyyy")</p>

                <h6 class="fw-bold text-uppercase text-white-50 small mb-1">About the Movie</h6>
                <p class="text-light leading-relaxed mb-4" style="max-width: 720px;">
                    @Model.Movie.Description
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a href="#showtimeSection" class="btn btn-primary-showsphere px-4 py-2">Select Showtime & Seats</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Showtimes & Date Selection Section -->
<section id="showtimeSection" class="py-5 bg-light">
    <div class="container">
        <!-- Date Selector Strip -->
        <div class="bg-white p-3 rounded-3 shadow-sm border mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="fw-bold mb-0">Select Date</h5>
                <span class="text-muted small">City: <strong>@Model.SelectedCity</strong></span>
            </div>
            <div class="d-flex gap-2 overflow-auto py-2">
                @foreach (var date in Model.AvailableDates)
                {
                    var isSelected = date.Date == Model.SelectedDate.Date;
                    <a asp-action="Details" 
                       asp-route-id="@Model.Movie.MovieId" 
                       asp-route-date="@date.ToString("yyyy-MM-dd")"
                       asp-route-city="@Model.SelectedCity"
                       class="btn text-center px-3 py-2 text-decoration-none rounded-3 @(isSelected ? "btn-danger text-white" : "btn-outline-secondary")"
                       style="min-width: 80px;">
                        <span class="d-block small text-uppercase" style="font-size: 0.7rem;">@date.ToString("ddd")</span>
                        <span class="d-block fw-bold fs-5">@date.ToString("dd")</span>
                        <span class="d-block small" style="font-size: 0.7rem;">@date.ToString("MMM")</span>
                    </a>
                }
            </div>
        </div>

        <!-- Theatres and Showtimes -->
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <h4 class="fw-bold mb-4">Theatres in @Model.SelectedCity</h4>

            @if (Model.Movie.Status == "Upcoming")
            {
                <div class="text-center py-5 bg-light rounded-3 border">
                    <div class="display-4 text-warning mb-2">⏳</div>
                    <h5 class="fw-bold">Coming Soon</h5>
                    <p class="text-muted small">Advance showtimes for this premiere will open shortly before release.</p>
                </div>
            }
            else if (Model.Theatres.Count == 0)
            {
                <div class="text-center py-5 bg-light rounded-3 border">
                    <div class="display-4 text-muted mb-2">🎟️</div>
                    <h5 class="fw-bold">No showtimes found</h5>
                    <p class="text-muted small">No showtimes are currently scheduled for @Model.SelectedDate.ToString("dd MMM yyyy") in @Model.SelectedCity. Please choose another date above.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var theatre in Model.Theatres)
                    {
                        <div class="border-bottom pb-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-danger me-1">
                                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                                        </svg>
                                        @theatre.TheatreName
                                    </h5>
                                    <p class="text-muted small mb-0">@theatre.Address</p>
                                </div>
                                <span class="badge bg-light text-muted border mt-2 mt-md-0">M-Ticket Available</span>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var slot in theatre.Slots)
                                {
                                    <a asp-controller="Booking" 
                                       asp-action="SeatMap" 
                                       asp-route-showtimeId="@slot.ShowtimeId"
                                       class="btn btn-outline-success px-3 py-2 rounded-2 text-start"
                                       style="min-width: 120px;">
                                        <span class="d-block fw-bold">@slot.StartTime.ToString("hh:mm tt")</span>
                                        <span class="d-block small text-muted" style="font-size: 0.725rem;">@slot.ScreenName (@slot.ScreenType)</span>
                                        <span class="d-block text-danger fw-semibold" style="font-size: 0.75rem;">₹@slot.LowestPrice onwards</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
