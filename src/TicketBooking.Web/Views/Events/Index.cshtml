@model TicketBooking.Web.ViewModels.Events.EventListViewModel
@{
    ViewData["Title"] = "Events in Rajkot - Discover Music, Comedy, Theatre & Workshop Shows";
    var currentCat = Model.SelectedCategory ?? "All";
    var activeCategoryNormal = currentCat switch
    {
        "Concert" => "Music Shows",
        "Theatre" => "Performances",
        "Comedy" => "Comedy Shows",
        "Workshop" => "Workshops",
        _ => currentCat
    };
}

<div class="bms-events-wrapper">
    <div class="bms-events-container">
        <div class="bms-events-layout">
            <!-- ==========================================================
                 LEFT SIDEBAR: BookMyShow Authentic Filters
                 ========================================================== -->
            <aside class="bms-filter-col" aria-label="Event Filters">
                <h1 class="bms-filter-heading">Filters</h1>

                <!-- 1. Categories Filter Card (Expanded by Default) -->
                <div class="bms-filter-card">
                    <div class="bms-filter-header" onclick="toggleAccordion('cat-body', 'cat-icon', 'cat-title')">
                        <div id="cat-title" class="bms-filter-title expanded">
                            <i id="cat-icon" class="bi bi-chevron-up text-danger"></i>
                            <span>Categories</span>
                        </div>
                        <a asp-action="Index" class="bms-filter-clear active">Clear</a>
                    </div>
                    <div id="cat-body" class="bms-filter-body">
                        <a asp-action="Index" asp-route-category="Music Shows" 
                           class="bms-filter-chip @(activeCategoryNormal == "Music Shows" ? "active" : "")">
                            Music Shows
                        </a>
                        <a asp-action="Index" asp-route-category="Performances" 
                           class="bms-filter-chip @(activeCategoryNormal == "Performances" ? "active" : "")">
                            Performances
                        </a>
                        <a asp-action="Index" asp-route-category="Comedy Shows" 
                           class="bms-filter-chip @(activeCategoryNormal == "Comedy Shows" ? "active" : "")">
                            Comedy Shows
                        </a>
                        <a asp-action="Index" asp-route-category="Workshops" 
                           class="bms-filter-chip @(activeCategoryNormal == "Workshops" ? "active" : "")">
                            Workshops
                        </a>
                        <a asp-action="Index" asp-route-category="Kids" 
                           class="bms-filter-chip @(activeCategoryNormal == "Kids" ? "active" : "")">
                            Kids
                        </a>
                        <a asp-action="Index" asp-route-category="Exhibitions" 
                           class="bms-filter-chip @(activeCategoryNormal == "Exhibitions" ? "active" : "")">
                            Exhibitions
                        </a>
                        <a asp-action="Index" asp-route-category="Meetups" 
                           class="bms-filter-chip @(activeCategoryNormal == "Meetups" ? "active" : "")">
                            Meetups
                        </a>
                    </div>
                </div>

                <!-- 2. Date Filter Card -->
                <div class="bms-filter-card">
                    <div class="bms-filter-header" onclick="toggleAccordion('date-body', 'date-icon', 'date-title')">
                        <div id="date-title" class="bms-filter-title">
                            <i id="date-icon" class="bi bi-chevron-down text-muted"></i>
                            <span>Date</span>
                        </div>
                        <span class="bms-filter-clear">Clear</span>
                    </div>
                    <div id="date-body" class="bms-filter-body" style="display: none;">
                        <a asp-action="Index" class="bms-filter-chip">Today</a>
                        <a asp-action="Index" class="bms-filter-chip">Tomorrow</a>
                        <a asp-action="Index" class="bms-filter-chip">This Weekend</a>
                    </div>
                </div>

                <!-- 3. Languages Filter Card -->
                <div class="bms-filter-card">
                    <div class="bms-filter-header" onclick="toggleAccordion('lang-body', 'lang-icon', 'lang-title')">
                        <div id="lang-title" class="bms-filter-title">
                            <i id="lang-icon" class="bi bi-chevron-down text-muted"></i>
                            <span>Languages</span>
                        </div>
                        <span class="bms-filter-clear">Clear</span>
                    </div>
                    <div id="lang-body" class="bms-filter-body" style="display: none;">
                        <a asp-action="Index" class="bms-filter-chip">Hindi</a>
                        <a asp-action="Index" class="bms-filter-chip">Gujarati</a>
                        <a asp-action="Index" class="bms-filter-chip">English</a>
                        <a asp-action="Index" class="bms-filter-chip">Punjabi</a>
                    </div>
                </div>

                <!-- 4. More Filters Card -->
                <div class="bms-filter-card">
                    <div class="bms-filter-header" onclick="toggleAccordion('more-body', 'more-icon', 'more-title')">
                        <div id="more-title" class="bms-filter-title">
                            <i id="more-icon" class="bi bi-chevron-down text-muted"></i>
                            <span>More Filters</span>
                        </div>
                        <span class="bms-filter-clear">Clear</span>
                    </div>
                    <div id="more-body" class="bms-filter-body" style="display: none;">
                        <a asp-action="Index" class="bms-filter-chip">Outdoor Events</a>
                        <a asp-action="Index" class="bms-filter-chip">Fast Filling</a>
                        <a asp-action="Index" class="bms-filter-chip">Kids Allowed</a>
                    </div>
                </div>

                <!-- 5. Price Filter Card -->
                <div class="bms-filter-card">
                    <div class="bms-filter-header" onclick="toggleAccordion('price-body', 'price-icon', 'price-title')">
                        <div id="price-title" class="bms-filter-title">
                            <i id="price-icon" class="bi bi-chevron-down text-muted"></i>
                            <span>Price</span>
                        </div>
                        <span class="bms-filter-clear">Clear</span>
                    </div>
                    <div id="price-body" class="bms-filter-body" style="display: none;">
                        <a asp-action="Index" class="bms-filter-chip">Free</a>
                        <a asp-action="Index" class="bms-filter-chip">0 - 500</a>
                        <a asp-action="Index" class="bms-filter-chip">501 - 2000</a>
                        <a asp-action="Index" class="bms-filter-chip">Above 2000</a>
                    </div>
                </div>

                <!-- Browse by Venues Button -->
                <a asp-action="Index" class="bms-browse-venues-btn">Browse by Venues</a>
            </aside>

            <!-- ==========================================================
                 RIGHT MAIN COLUMN: Events In Rajkot + 4-Col Grid
                 ========================================================== -->
            <main class="bms-events-content">
                <!-- Page Title -->
                <h2 class="bms-events-heading">Events In Rajkot</h2>

                <!-- Category Pill Quick-Filter Buttons -->
                <div class="bms-pill-bar" role="navigation" aria-label="Quick Category Filter">
                    <a asp-action="Index" 
                       class="bms-pill-btn @(activeCategoryNormal == "All" || string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                        All
                    </a>
                    <a asp-action="Index" asp-route-category="Music Shows" 
                       class="bms-pill-btn @(activeCategoryNormal == "Music Shows" ? "active" : "")">
                        Music Shows
                    </a>
                    <a asp-action="Index" asp-route-category="Performances" 
                       class="bms-pill-btn @(activeCategoryNormal == "Performances" ? "active" : "")">
                        Performances
                    </a>
                    <a asp-action="Index" asp-route-category="Comedy Shows" 
                       class="bms-pill-btn @(activeCategoryNormal == "Comedy Shows" ? "active" : "")">
                        Comedy Shows
                    </a>
                    <a asp-action="Index" asp-route-category="Workshops" 
                       class="bms-pill-btn @(activeCategoryNormal == "Workshops" ? "active" : "")">
                        Workshops
                    </a>
                    <a asp-action="Index" asp-route-category="Kids" 
                       class="bms-pill-btn @(activeCategoryNormal == "Kids" ? "active" : "")">
                        Kids
                    </a>
                    <a asp-action="Index" asp-route-category="Exhibitions" 
                       class="bms-pill-btn @(activeCategoryNormal == "Exhibitions" ? "active" : "")">
                        Exhibitions
                    </a>
                    <a asp-action="Index" asp-route-category="Meetups" 
                       class="bms-pill-btn @(activeCategoryNormal == "Meetups" ? "active" : "")">
                        Meetups
                    </a>
                    <a asp-action="Index" asp-route-category="Sports" 
                       class="bms-pill-btn @(activeCategoryNormal == "Sports" ? "active" : "")">
                        Sports
                    </a>
                </div>

                <!-- Events 4-Column Grid -->
                @if (Model.Events.Count == 0)
                {
                    <div class="bg-white rounded-3 p-5 text-center my-4 border">
                        <i class="bi bi-calendar-x fs-1 text-danger mb-3 d-block"></i>
                        <h4 class="fw-bold text-dark">No Events Found</h4>
                        <p class="text-muted mb-4">No scheduled live events match your current filter selection in Rajkot.</p>
                        <a asp-action="Index" class="btn btn-danger px-4 py-2 rounded-2" style="background-color: #EB4E62; border-color: #EB4E62;">
                            Clear All Filters
                        </a>
                    </div>
                }
                else
                {
                    <div class="bms-event-grid">
                        @foreach (var ev in Model.Events)
                        {
                            var isPromoted = ev.EventId == 23 || ev.EventId == 11;
                            var categoryLabel = ev.Category switch
                            {
                                "Concert" => "Concerts",
                                "Comedy" => "Stand up Comedy",
                                "Theatre" => "Theatre",
                                "Workshop" => "Workshops",
                                "Sports" => "Sports",
                                _ => ev.Category
                            };

                            <a asp-action="Details" asp-route-id="@ev.EventId" class="bms-event-card-link">
                                <!-- Card Poster Container -->
                                <div class="bms-event-card-poster">
                                    <img src="@ev.BannerUrl" alt="@ev.Title" loading="lazy" />

                                    <!-- Promoted Tag Top-Right -->
                                    @if (isPromoted)
                                    {
                                        <span class="bms-promoted-tag">PROMOTED</span>
                                    }

                                    <!-- Solid Black Date Strip Overlay at Bottom -->
                                    <div class="bms-event-date-strip">
                                        @ev.StartDate.ToString("ddd, d MMM")
                                    </div>
                                </div>

                                <!-- Card Details Section Below Poster -->
                                <div class="bms-event-details">
                                    <h3 class="bms-event-title" title="@ev.Title">@ev.Title</h3>
                                    <div class="bms-event-venue" title="@ev.VenueName, @ev.CityName">@ev.VenueName</div>
                                    <div class="bms-event-category">@categoryLabel</div>
                                    <div class="bms-event-price">
                                        ₹ @ev.StartingPrice.ToString("N0") onwards
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </main>
        </div>
    </div>
</div>

<script>
    function toggleAccordion(bodyId, iconId, titleId) {
        var body = document.getElementById(bodyId);
        var icon = document.getElementById(iconId);
        var title = document.getElementById(titleId);

        if (!body) return;

        if (body.style.display === 'none' || body.style.display === '') {
            body.style.display = 'flex';
            if (icon) {
                icon.className = 'bi bi-chevron-up text-danger';
            }
            if (title) {
                title.classList.add('expanded');
            }
        } else {
            body.style.display = 'none';
            if (icon) {
                icon.className = 'bi bi-chevron-down text-muted';
            }
            if (title) {
                title.classList.remove('expanded');
            }
        }
    }
</script>
