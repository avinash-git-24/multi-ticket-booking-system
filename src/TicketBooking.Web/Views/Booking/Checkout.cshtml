@model TicketBooking.Web.ViewModels.Booking.CheckoutViewModel
@{
    ViewData["Title"] = $"Checkout: {Model.BookingReference} - ShowSphere";
}

<div class="container py-4 pb-5">
    <!-- Academic Demo Disclaimer -->
    <div class="alert alert-warning border-warning shadow-sm mb-4">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4">⚠️</span>
            <div>
                <strong>College Demonstration Notice:</strong> This checkout utilizes a simulated payment environment.
                No real card details or bank credentials are required or processed.
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Timer Countdown Bar -->
    <div class="bg-light p-3 rounded-3 border d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-muted small">Booking Reservation Reference:</span>
            <span class="badge bg-dark fs-6 ms-2">@Model.BookingReference</span>
        </div>
        <div>
            <span class="text-muted small me-2">Seats held for:</span>
            <span id="countdownTimer" class="badge bg-danger fs-6">08:00</span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Payment Simulation Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold mb-3">Simulated Payment Gateway</h4>
                <p class="text-muted small mb-4">
                    Choose a simulated payment method and outcome to test the transactional reservation pipeline.
                </p>

                <form method="post" asp-action="ProcessPayment">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BookingReference" value="@Model.BookingReference" />

                    <!-- Simulated Payment Mode -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-uppercase text-muted">Payment Mode</label>
                        <div class="d-flex flex-column gap-2">
                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 cursor-pointer">
                                <input type="radio" name="PaymentMode" value="UPI" checked class="form-check-input" />
                                <div>
                                    <div class="fw-bold">UPI / QR Simulation</div>
                                    <div class="text-muted small">Instant simulated UPI authorization</div>
                                </div>
                            </label>

                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 cursor-pointer">
                                <input type="radio" name="PaymentMode" value="Card" class="form-check-input" />
                                <div>
                                    <div class="fw-bold">Simulated Credit / Debit Card</div>
                                    <div class="text-muted small">Test card processing flow</div>
                                </div>
                            </label>

                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 cursor-pointer">
                                <input type="radio" name="PaymentMode" value="NetBanking" class="form-check-input" />
                                <div>
                                    <div class="fw-bold">Simulated Net Banking</div>
                                    <div class="text-muted small">Retail bank gateway simulation</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Faculty Demonstration Outcome Selector -->
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <label class="form-label small fw-bold text-danger text-uppercase">Demonstration Outcome Control</label>
                        <select name="SimulationOutcome" class="form-select">
                            <option value="Success" selected>Test Success: Confirm booking & permanently lock seats</option>
                            <option value="FailureInsufficientFunds">Test Failure: Insufficient funds (Release seats back to available)</option>
                            <option value="FailureTimeout">Test Failure: Gateway timeout (Release seats back to available)</option>
                        </select>
                        <div class="form-text small">
                            Use this selector during faculty evaluation to demonstrate automatic rollback and inventory restoration.
                        </div>
                    </div>

                    <button type="submit" id="btnPayNow" class="btn btn-primary-showsphere w-100 py-3 fw-bold fs-5">
                        Pay ₹@Model.TotalAmount.ToString("N2")
                    </button>
                </form>
            </div>
        </div>

        <!-- Order Summary Column -->
        <div class="col-lg-5">
            <div class="checkout-card">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Order Summary</h5>

                <div class="mb-3">
                    <h5 class="fw-bold text-dark mb-1">@Model.ItemTitle</h5>
                    <div class="text-muted small">@Model.VenueName @(!string.IsNullOrEmpty(Model.SubVenue) ? $"• {Model.SubVenue}" : "")</div>
                    <div class="text-muted small">@Model.EventDateTime.ToString("dddd, dd MMMM yyyy • hh:mm tt")</div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-3 small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Tickets / Seats (@Model.Quantity):</span>
                        <span class="fw-bold text-dark">@string.Join(", ", Model.SeatOrTicketLabels)</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Type:</span>
                        <span class="badge bg-secondary">@Model.BookingType Booking</span>
                    </div>
                </div>

                <div class="price-row">
                    <span>Base Ticket Amount:</span>
                    <span>₹@Model.BaseAmount.ToString("N2")</span>
                </div>

                <div class="price-row">
                    <span>Convenience Fee (10%):</span>
                    <span>₹@Model.ConvenienceFee.ToString("N2")</span>
                </div>

                <div class="price-row">
                    <span>Integrated GST (18% on fee):</span>
                    <span>₹@Model.TaxAmount.ToString("N2")</span>
                </div>

                <div class="price-row total-row">
                    <span>Amount Payable:</span>
                    <span class="text-danger">₹@Model.TotalAmount.ToString("N2")</span>
                </div>

                <div class="mt-3 text-center">
                    <span class="text-muted small">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-success me-1">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                        </svg>
                        100% Secure Simulated Transaction
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let remainingSeconds = @Model.RemainingSeconds;
        const timerElement = document.getElementById('countdownTimer');
        const payButton = document.getElementById('btnPayNow');

        const interval = setInterval(() => {
            if (remainingSeconds <= 0) {
                clearInterval(interval);
                timerElement.innerText = "00:00 (Expired)";
                payButton.setAttribute('disabled', 'true');
                payButton.innerText = "Reservation Expired";
                alert("Your 8-minute reservation time has expired. The held seats have been released.");
                window.location.href = "/Movies";
                return;
            }

            remainingSeconds--;
            const mins = Math.floor(remainingSeconds / 60);
            const secs = remainingSeconds % 60;
            timerElement.innerText = (mins < 10 ? "0" : "") + mins + ":" + (secs < 10 ? "0" : "") + secs;
        }, 1000);
    </script>
}
