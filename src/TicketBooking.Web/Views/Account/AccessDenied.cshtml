@{
    ViewData["Title"] = "Access Denied - ShowSphere";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-4 shadow-sm border">
                <div class="display-3 text-danger mb-3">🚫</div>
                <h2 class="fw-bold mb-2">Access Restricted</h2>
                <p class="text-muted mb-4">
                    You do not have the required administrative role to view this page. This administrative route is restricted to authorized faculty and system administrators.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Back to Home</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-showsphere px-4">Sign In as Admin</a>
                </div>
            </div>
        </div>
    </div>
</div>
