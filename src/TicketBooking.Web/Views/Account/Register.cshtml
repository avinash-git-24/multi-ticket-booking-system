@model TicketBooking.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account - ShowSphere";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-2 text-center">
                    <span class="brand-icon mb-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </span>
                    <h3 class="fw-bold mb-1">Create an Account</h3>
                    <p class="text-muted small">Join ShowSphere to book movie and event tickets across Gujarat</p>
                </div>

                <div class="card-body p-4 pt-2">
                    <form method="post" asp-controller="Account" asp-action="Register">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-semibold">Full Name</label>
                            <input asp-for="FullName" class="form-control py-2" placeholder="e.g. Ramesh Patel" autofocus />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-7">
                                <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                                <input asp-for="Email" class="form-control py-2" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="PhoneNumber" class="form-label small fw-semibold">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control py-2" placeholder="+91 9876543210" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PreferredCityId" class="form-label small fw-semibold">Default City</label>
                            <select asp-for="PreferredCityId" class="form-select py-2">
                                <option value="1" selected>Rajkot, Gujarat (Default)</option>
                                <option value="2">Ahmedabad, Gujarat</option>
                                <option value="3">Surat, Gujarat</option>
                                <option value="4">Vadodara, Gujarat</option>
                                <option value="5">Mumbai, Maharashtra</option>
                            </select>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label small fw-semibold">Password (min 6 characters)</label>
                                <input asp-for="Password" class="form-control py-2" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control py-2" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary-showsphere w-100 py-2 mb-3">Create Free Account</button>

                        <div class="text-center small text-muted">
                            Already have an account? <a asp-controller="Account" asp-action="Login" class="text-danger fw-semibold text-decoration-none">Sign In</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
