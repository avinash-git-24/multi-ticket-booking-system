@model TicketBooking.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In - ShowSphere";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-2 text-center">
                    <span class="brand-icon mb-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z"/>
                        </svg>
                    </span>
                    <h3 class="fw-bold mb-1">Welcome Back</h3>
                    <p class="text-muted small">Sign in to access your bookings and tickets</p>
                </div>

                <div class="card-body p-4 pt-2">
                    <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                            <input asp-for="Email" id="inputEmail" class="form-control py-2" placeholder="Enter your email" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                            <input asp-for="Password" id="inputPassword" type="password" class="form-control py-2" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted">Remember me</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary-showsphere w-100 py-2 mb-3">Sign In</button>

                        <div class="text-center small text-muted">
                            Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-danger fw-semibold text-decoration-none">Create Account</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
