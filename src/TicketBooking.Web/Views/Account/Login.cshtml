@model TicketBooking.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In - ShowSphere";
}

<div class="py-5" style="min-height: calc(100vh - 220px); background: linear-gradient(180deg, #F8FAFC 0%, #EEF2F6 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <!-- Card Top Header -->
                    <div class="card-header bg-white border-0 pt-4 pb-2 text-center">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 48px; height: 48px; background-color: rgba(235, 78, 98, 0.1); color: #EB4E62;">
                            <i class="bi bi-ticket-perforated-fill fs-4"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1" style="font-family: 'Roboto', sans-serif;">Welcome to ShowSphere</h4>
                        <p class="text-muted small mb-0">Sign in to book movies, live events, and manage tickets</p>
                    </div>

                    <div class="card-body p-4 pt-2">
                        <!-- Active Session Notice (If already logged in) -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="p-3 mb-3 rounded-3 border" style="background-color: #F0FDF4; border-color: #BBF7D0 !important;">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle bg-success d-inline-block" style="width: 8px; height: 8px;"></span>
                                        <span class="small text-dark fw-semibold">Active Session</span>
                                    </div>
                                    <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-primary")" style="font-size: 10px;">
                                        @(User.IsInRole("Admin") ? "Administrator" : "Customer")
                                    </span>
                                </div>
                                <div class="small text-muted mb-2 text-truncate">
                                    Signed in as <strong class="text-dark">@(User.Identity.Name)</strong>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-danger flex-grow-1" style="font-size: 12px;">Admin Portal</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="MyBookings" class="btn btn-sm btn-outline-secondary flex-grow-1" style="font-size: 12px;">My Bookings</a>
                                    }
                                    <a asp-controller="Account" asp-action="LogoutDirect" class="btn btn-sm btn-danger text-white flex-grow-1" style="font-size: 12px;">Sign Out</a>
                                </div>
                            </div>
                        }

                        <!-- Quick 1-Click Demo Fill Shortcuts -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary d-flex align-items-center justify-content-between mb-1">
                                <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i>1-Click Quick Demo Login</span>
                                <span class="badge bg-light text-muted border" style="font-size: 10px;">Evaluation</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <button type="button" class="btn btn-sm btn-outline-danger w-100 py-1 text-truncate rounded-2 fw-medium" style="font-size: 12px;" onclick="fillDemoCredentials('abhay@gmail.com', 'abhay@123')">
                                        <i class="bi bi-person-fill me-1"></i>Abhay Login
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-1 text-truncate rounded-2 fw-medium" style="font-size: 12px;" onclick="fillDemoCredentials('admin@showsphere.local', 'Admin@ShowSphere2026!')">
                                        <i class="bi bi-shield-lock me-1"></i>Admin Demo
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- BookMyShow Simulated Google Sign-In Button -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-secondary w-100 py-2 rounded-2 d-flex align-items-center justify-content-center gap-2 fw-medium shadow-none" style="font-size: 13.5px; border-color: #E2E8F0;" onclick="fillDemoCredentials('abhay@gmail.com', 'abhay@123', true)">
                                <svg width="18" height="18" viewBox="0 0 24 24">
                                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                                    <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                                </svg>
                                <span>Continue as Abhay (Simulated)</span>
                            </button>
                        </div>

                        <!-- Divider -->
                        <div class="position-relative text-center my-3">
                            <hr class="text-secondary opacity-25 my-0" />
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted fw-normal" style="font-size: 11px; letter-spacing: 0.5px;">OR SIGN IN WITH EMAIL</span>
                        </div>

                        <!-- Main Login Form -->
                        <form method="post" id="loginForm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                            <!-- Email Input -->
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-semibold text-dark mb-1">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #E2E8F0;">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" id="inputEmail" class="form-control border-start-0 ps-0" placeholder="abhay@gmail.com" style="border-color: #E2E8F0; font-size: 14px;" autofocus />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password Input with Eye Toggle -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="Password" class="form-label small fw-semibold text-dark mb-0">Password</label>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #E2E8F0;">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="Password" id="inputPassword" type="password" class="form-control border-start-0 border-end-0 px-0" placeholder="abhay@123" style="border-color: #E2E8F0; font-size: 14px;" />
                                    <button class="btn btn-outline-secondary border-start-0 text-muted bg-white" type="button" id="togglePasswordBtn" style="border-color: #E2E8F0;" onclick="togglePasswordVisibility()">
                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me Checkbox -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                                    <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
                                </div>
                            </div>

                            <!-- Sign In Submit Button -->
                            <button type="submit" id="submitLoginBtn" class="bms-nav-signin-btn w-100 py-2 rounded-2 fw-semibold shadow-sm text-center text-decoration-none" style="height: 42px; font-size: 15px; display: block; border-radius: 8px;">
                                Sign In
                            </button>

                            <div class="text-center small text-muted mt-3">
                                Don't have an account? 
                                <a asp-controller="Account" asp-action="Register" class="text-danger fw-semibold text-decoration-none ms-1">Create Account</a>
                            </div>
                        </form>

                        <!-- Academic Credentials Reference Box -->
                        <div class="mt-4 p-3 bg-light rounded-3 border" style="font-size: 12px;">
                            <div class="fw-bold text-dark d-flex align-items-center gap-1 mb-2">
                                <i class="bi bi-info-circle-fill text-danger"></i>
                                <span>Demo Login Credentials for Faculty:</span>
                            </div>
                            <div class="mb-1 d-flex justify-content-between">
                                <span class="text-muted">Account Email:</span>
                                <span class="fw-mono text-dark fw-semibold">abhay@gmail.com</span>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">Account Password:</span>
                                <span class="fw-mono text-dark fw-semibold">abhay@123</span>
                            </div>
                            <div class="border-top pt-2 d-flex justify-content-between">
                                <span class="text-muted">Admin Account:</span>
                                <span class="fw-mono text-dark">admin@showsphere.local</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Admin Password:</span>
                                <span class="fw-mono text-dark">Admin@ShowSphere2026!</span>
                            </div>
                        </div>

                        <!-- Security & Privacy Footer Note -->
                        <div class="text-center text-muted mt-3" style="font-size: 11px;">
                            <i class="bi bi-shield-check text-success me-1"></i>256-bit encrypted demonstration session.
                            <div class="mt-1">By continuing, you agree to our Terms &amp; Privacy Policy.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillDemoCredentials(email, pwd, autoSubmit = false) {
            const emailInput = document.getElementById('inputEmail');
            const pwdInput = document.getElementById('inputPassword');
            
            if (emailInput && pwdInput) {
                emailInput.value = email;
                pwdInput.value = pwd;

                // Visual flash indicator
                emailInput.classList.add('is-valid');
                pwdInput.classList.add('is-valid');
                setTimeout(() => {
                    emailInput.classList.remove('is-valid');
                    pwdInput.classList.remove('is-valid');
                }, 1200);

                if (autoSubmit) {
                    const form = document.getElementById('loginForm');
                    if (form) form.submit();
                }
            }
        }

        function togglePasswordVisibility() {
            const pwdInput = document.getElementById('inputPassword');
            const icon = document.getElementById('togglePasswordIcon');
            if (!pwdInput || !icon) return;

            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                pwdInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye-warning', 'bi-eye');
            }
        }
    </script>
}
