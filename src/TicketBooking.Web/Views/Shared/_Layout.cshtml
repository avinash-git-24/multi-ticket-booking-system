                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 p-2" style="background-color: rgba(220, 53, 75, 0.15); border: 1px solid rgba(220, 53, 75, 0.3);">
                        <i class="bi bi-shop fs-3 text-danger"></i>
                    </div>
                    <div>
                        <span class="fw-bold d-block text-white" style="font-size: 16px;">List your Show</span>
                        <span style="color: #CBD5E1; font-size: 13.5px;">Got a show, event, activity or a great experience? Partner with us &amp; get listed on ShowSphere</span>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="Register" class="btn text-white fw-semibold px-4 py-2 text-nowrap rounded-2 shadow-sm" style="background-color: #DC354B; border: none; font-size: 14.5px;">
