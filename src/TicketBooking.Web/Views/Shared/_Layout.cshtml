<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShowSphere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Persistent Demo Notice -->
    <div class="college-demo-banner">
        <span class="badge bg-danger text-white">NOTICE</span>
        <span>College Demonstration System: Simulated payment only. No real financial data is collected or charged.</span>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky-top bg-white">
        <nav class="navbar navbar-expand-lg navbar-showsphere">
            <div class="container">
                <!-- Brand Logo -->
                <a class="brand-logo me-4" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-5 14H9v-2h6v2zm0-5H9v-2h6v2zm0-5H9V6h6v2z"/>
                        </svg>
                    </span>
                    <span>ShowSphere</span>
                </a>

                <!-- City Selector Dropdown -->
                <div class="dropdown me-3 d-none d-md-block">
                    <button class="city-selector dropdown-toggle" type="button" id="cityDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-danger">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                        </svg>
                        <span id="currentCityLabel">@(Context.Request.Cookies["SelectedCity"] ?? "Rajkot")</span>
                    </button>
                    <ul class="dropdown-menu shadow-sm" aria-labelledby="cityDropdown">
                        <li><a class="dropdown-item city-option" href="#" data-city="Rajkot">Rajkot (Default)</a></li>
                        <li><a class="dropdown-item city-option" href="#" data-city="Ahmedabad">Ahmedabad</a></li>
                        <li><a class="dropdown-item city-option" href="#" data-city="Surat">Surat</a></li>
                        <li><a class="dropdown-item city-option" href="#" data-city="Vadodara">Vadodara</a></li>
                        <li><a class="dropdown-item city-option" href="#" data-city="Mumbai">Mumbai</a></li>
                    </ul>
                </div>

                <!-- Global Search Input -->
                <form class="search-pill-container me-auto d-none d-lg-block" method="get" asp-controller="Movies" asp-action="Index">
                    <span class="search-icon-inside">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="search" name="search" class="search-pill" placeholder="Search for Movies, Events, Plays, Sports and Activities" />
                </form>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#showsphereNav" aria-controls="showsphereNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="showsphereNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-2 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Movies" asp-action="Index">Movies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Events" asp-action="Index">Events</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-semibold text-dark" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="badge bg-light text-dark border me-1">Hi, @(User.Identity.Name ?? "Account")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="MyBookings">My Bookings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger fw-bold" asp-controller="Admin" asp-action="Index">Admin Portal</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout" class="px-2 py-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-semibold" style="background-color: #F84464; border-color: #F84464;" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Secondary Categories Subnav (BookMyShow Dual-Side Strip) -->
        <div class="subnav-categories d-none d-md-block border-bottom bg-white">
            <div class="container d-flex justify-content-between align-items-center py-1">
                <div class="d-flex gap-4">
                    <a class="subnav-link text-decoration-none fw-semibold small" asp-controller="Movies" asp-action="Index">Movies</a>
                    <a class="subnav-link text-decoration-none fw-semibold small" asp-controller="Movies" asp-action="Index" asp-route-status="Upcoming">Stream</a>
                    <a class="subnav-link text-decoration-none fw-semibold small" asp-controller="Events" asp-action="Index">Events</a>
                    <a class="subnav-link text-decoration-none fw-semibold small" asp-controller="Events" asp-action="Index" asp-route-category="Theatre">Plays</a>
                    <a class="subnav-link text-decoration-none fw-semibold small" asp-controller="Events" asp-action="Index" asp-route-category="Sports">Sports</a>
                    <a class="subnav-link text-decoration-none fw-semibold small" asp-controller="Events" asp-action="Index" asp-route-category="Workshop">Activities</a>
                </div>
                <div class="d-flex gap-3 small">
                    <a class="text-decoration-none text-secondary" style="font-size: 0.8rem;" asp-controller="Account" asp-action="Register">ListYourShow</a>
                    <a class="text-decoration-none text-secondary" style="font-size: 0.8rem;" asp-controller="Home" asp-action="Index">Corporates</a>
                    <a class="text-decoration-none text-secondary" style="font-size: 0.8rem;" asp-controller="Home" asp-action="Index">Offers</a>
                    <a class="text-decoration-none text-secondary" style="font-size: 0.8rem;" asp-controller="Home" asp-action="Index">Gift Cards</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main View Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-showsphere">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="text-white fw-bold mb-3">
                        <span class="brand-icon me-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z"/>
                            </svg>
                        </span>
                        ShowSphere
                    </h5>
                    <p class="text-muted small">
                        ShowSphere is a full-stack Movie and Event Ticket Booking System engineered for an academic live demonstration.
                        Built with C#, ASP.NET Core MVC, pure ADO.NET (Microsoft.Data.SqlClient), and Microsoft SQL Server 2022.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary">ASP.NET Core MVC</span>
                        <span class="badge bg-secondary">ADO.NET</span>
                        <span class="badge bg-secondary">SQL Server</span>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-bold mb-3">Explore</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Movies" asp-action="Index">Movies in Rajkot</a></li>
                        <li><a asp-controller="Events" asp-action="Index">Live Events</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-status="Upcoming">Upcoming Premieres</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-bold mb-3">My Account</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Account" asp-action="MyBookings">Booking History</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Create Account</a></li>
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h6 class="text-white fw-bold mb-3">Academic Transparency</h6>
                    <p class="text-muted small">
                        All catalogue data is tagged with verification metadata. Live movie releases reflect official production listings; showtimes and simulated seat inventory are created for college evaluation purposes.
                    </p>
                    <p class="small text-danger fw-semibold">
                        Simulated Payment Mode: No real monetary value is processed.
                    </p>
                </div>
            </div>

            <div class="footer-divider"></div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small">
                <div>&copy; 2026 ShowSphere. Designed and developed by Avinash Kumar for college demonstration.</div>
                <div class="mt-2 mt-sm-0">
                    <span class="text-light">Rajkot, Gujarat, India</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // City selector cookie handler
        document.querySelectorAll('.city-option').forEach(function(item) {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                var city = this.getAttribute('data-city');
                document.cookie = "SelectedCity=" + encodeURIComponent(city) + "; path=/; max-age=2592000";
                var label = document.getElementById('currentCityLabel');
                if (label) label.innerText = city;
                window.location.reload();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
