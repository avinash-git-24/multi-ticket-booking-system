<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShowSphere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bms-bg-page">
    <!-- Academic Simulation Notice Bar -->
    <div class="college-demo-banner py-1 px-3 d-flex align-items-center justify-content-center gap-2 small" style="background-color: #FFF3CD; color: #856404; border-bottom: 1px solid #FFEEBA; font-size: 0.78rem;">
        <span class="badge bg-warning text-dark px-2 py-0">COLLEGE DEMO</span>
        <span>Simulated payment mode for faculty evaluation. No real card details or live bank transactions are processed.</span>
    </div>

    <!-- 1. Tier 1 Main Header Bar (BookMyShow Height 64px, White, 1240px) -->
    <header class="sticky-top shadow-sm bg-white">
        <div class="border-bottom bg-white" style="height: 64px;">
            <div class="bms-container h-100 d-flex align-items-center justify-content-between">
                <!-- Brand Logo & Search Bar -->
                <div class="d-flex align-items-center gap-4 flex-grow-1">
                    <a class="d-flex align-items-center text-decoration-none" asp-controller="Home" asp-action="Index">
                        <span class="fw-bold fs-4" style="color: #EB4E62; letter-spacing: -0.5px;">
                            <i class="bi bi-ticket-perforated-fill me-1"></i>ShowSphere
                        </span>
                    </a>

                    <!-- BMS 549px x 36px Search Input -->
                    <form class="d-none d-lg-flex align-items-center px-3 py-1 bg-white flex-grow-1" style="max-width: 550px; height: 36px; border: 1px solid #EEEEEE; border-radius: 4px;" method="get" asp-controller="Movies" asp-action="Index">
                        <i class="bi bi-search text-secondary me-2" style="font-size: 13px;"></i>
                        <input type="search" name="search" class="border-0 w-100 bg-transparent text-dark" style="outline: none; font-size: 14px; font-family: 'Roboto', sans-serif;" placeholder="Search for Movies, Events, Plays, Sports and Activities" />
                    </form>
                </div>

                <!-- Right Side Actions: Location, Sign In, Hamburger -->
                <div class="d-flex align-items-center gap-3 ms-3">
                    <!-- City Selector Dropdown (Rajkot) -->
                    <div class="dropdown">
                        <button class="btn btn-sm text-dark d-flex align-items-center gap-1 border-0 p-0 fw-normal" type="button" id="cityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 15px; font-family: 'Roboto', sans-serif; color: #333333;">
                            <span id="currentCityLabel">@(Context.Request.Cookies["SelectedCity"] ?? "Rajkot")</span>
                            <i class="bi bi-chevron-down text-secondary" style="font-size: 11px;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="cityDropdown">
                            <li><a class="dropdown-item city-option" href="#" data-city="Rajkot">Rajkot (Current)</a></li>
                            <li><a class="dropdown-item city-option" href="#" data-city="Ahmedabad">Ahmedabad</a></li>
                            <li><a class="dropdown-item city-option" href="#" data-city="Surat">Surat</a></li>
                            <li><a class="dropdown-item city-option" href="#" data-city="Vadodara">Vadodara</a></li>
                            <li><a class="dropdown-item city-option" href="#" data-city="Mumbai">Mumbai</a></li>
                        </ul>
                    </div>

                    <!-- User / Auth Buttons -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-1 px-3 rounded-1" style="font-size: 12px;" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                Hi, @(User.Identity.Name ?? "Account")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="MyBookings">My Bookings</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Admin" asp-action="Index">Admin Portal</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="px-2 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm text-white fw-normal d-flex align-items-center justify-content-center" style="width: 72px; height: 28px; background-color: #EB4E62; border-radius: 4px; font-size: 12px; font-family: 'Roboto', sans-serif;" asp-controller="Account" asp-action="Login">
                            Sign in
                        </a>
                    }

                    <!-- Hamburger Menu Icon -->
                    <button class="btn btn-sm text-dark p-0 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#bmsSideMenu" aria-controls="bmsSideMenu">
                        <i class="bi bi-list fs-4 text-secondary"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 2. Tier 2 Sub-Navbar (BookMyShow Height 40px, #F5F5F5) -->
        <div class="border-bottom" style="height: 40px; background-color: #F5F5F5;">
            <div class="bms-container h-100 d-flex justify-content-between align-items-center">
                <!-- Left Nav Items -->
                <div class="d-flex gap-4">
                    <a class="text-decoration-none fw-normal" style="font-size: 14px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Movies" asp-action="Index">Movies</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 14px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Movies" asp-action="Index" asp-route-status="Upcoming">Stream</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 14px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Events" asp-action="Index">Events</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 14px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Events" asp-action="Index" asp-route-category="Theatre">Plays</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 14px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Events" asp-action="Index" asp-route-category="Sports">Sports</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 14px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Events" asp-action="Index" asp-route-category="Workshop">Activities</a>
                </div>

                <!-- Right Nav Items -->
                <div class="d-none d-md-flex gap-4">
                    <a class="text-decoration-none fw-normal" style="font-size: 12px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Account" asp-action="Register">ListYourShow</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 12px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Home" asp-action="Index">Corporates</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 12px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Home" asp-action="Index">Offers</a>
                    <a class="text-decoration-none fw-normal" style="font-size: 12px; color: #333333; font-family: 'Roboto', sans-serif;" asp-controller="Home" asp-action="Index">Gift Cards</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Slide-in Offcanvas Menu (BookMyShow Hamburger Drawer) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="bmsSideMenu" aria-labelledby="bmsSideMenuLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold" id="bmsSideMenuLabel" style="color: #EB4E62;">
                <i class="bi bi-ticket-perforated-fill me-1"></i>Hey! Welcome
            </h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="p-3 border-bottom bg-light">
                <a asp-controller="Account" asp-action="Login" class="btn btn-danger w-100 py-2 rounded-2 fw-semibold" style="background-color: #EB4E62; border-color: #EB4E62;">Login / Register</a>
            </div>
            <div class="list-group list-group-flush small">
                <a asp-controller="Account" asp-action="MyBookings" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3">
                    <i class="bi bi-bell fs-5 text-secondary"></i> Notifications &amp; Bookings
                </a>
                <a asp-controller="Movies" asp-action="Index" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3">
                    <i class="bi bi-film fs-5 text-secondary"></i> All Movies in Rajkot
                </a>
                <a asp-controller="Events" asp-action="Index" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3">
                    <i class="bi bi-calendar-event fs-5 text-secondary"></i> All Events &amp; Live Shows
                </a>
                <a asp-controller="Account" asp-action="Register" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3">
                    <i class="bi bi-megaphone fs-5 text-secondary"></i> List Your Show
                </a>
            </div>
        </div>
    </div>

    <!-- Main View Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ======================================================================
         BookMyShow 4-Tier Authentic Footer
         ====================================================================== -->
    <footer class="mt-5 text-white" style="font-family: 'Roboto', sans-serif;">
        <!-- Tier 1: List Your Show Partner Bar (#333333, Height 88px) -->
        <div class="border-bottom" style="background-color: #333333; min-height: 88px;">
            <div class="bms-container h-100 py-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-building fs-2 text-danger"></i>
                    <div>
                        <span class="fw-bold d-block text-white" style="font-size: 16px;">List your Show</span>
                        <span class="text-white-50" style="font-size: 14px;">Got a show, event, activity or a great experience? Partner with us &amp; get listed on ShowSphere</span>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="Register" class="btn text-white fw-semibold px-4 py-2 text-nowrap rounded-2" style="background-color: #DC354B; border: none; font-size: 15px;">
                    Contact today!
                </a>
            </div>
        </div>

        <!-- Tier 2: 24/7 Services & Customer Care Bar (#404040, Height 102px) -->
        <div class="border-bottom" style="background-color: #404040; min-height: 102px;">
            <div class="bms-container h-100 py-4">
                <div class="row text-center g-4">
                    <div class="col-md-4 d-flex flex-column align-items-center justify-content-center cursor-pointer">
                        <i class="bi bi-headset fs-2 text-white-50 mb-1"></i>
                        <span class="text-uppercase" style="font-size: 12px; color: #CCCCCC;">24/7 CUSTOMER CARE</span>
                    </div>
                    <div class="col-md-4 d-flex flex-column align-items-center justify-content-center cursor-pointer">
                        <i class="bi bi-ticket-perforated fs-2 text-white-50 mb-1"></i>
                        <span class="text-uppercase" style="font-size: 12px; color: #CCCCCC;">RESEND BOOKING CONFIRMATION</span>
                    </div>
                    <div class="col-md-4 d-flex flex-column align-items-center justify-content-center cursor-pointer">
                        <i class="bi bi-envelope fs-2 text-white-50 mb-1"></i>
                        <span class="text-uppercase" style="font-size: 12px; color: #CCCCCC;">SUBSCRIBE TO THE NEWSLETTER</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tier 3: SEO Links Directory Grid (#333333, Padding 40px 0) -->
        <div class="border-bottom py-5" style="background-color: #333333; color: #808080; font-size: 11px; line-height: 22px;">
            <div class="bms-container">
                <!-- Group 1: Movies Showing in Rajkot -->
                <div class="mb-4">
                    <span class="text-uppercase fw-semibold d-block text-white-50 mb-2" style="font-size: 12px;">MOVIES NOW SHOWING IN RAJKOT</span>
                    <span class="text-muted">
                        Singham Again | Kasoombo | Stree 2 | Kalki 2898 AD | Bhool Bhulaiyaa 3 | Devara: Part 1 | Jigra
                    </span>
                </div>

                <!-- Group 2: Upcoming Movies in Rajkot -->
                <div class="mb-4">
                    <span class="text-uppercase fw-semibold d-block text-white-50 mb-2" style="font-size: 12px;">UPCOMING MOVIES IN RAJKOT</span>
                    <span class="text-muted">
                        Pushpa 2: The Rule | Transformers One | Venom: The Last Dance | Alien: Romulus | A Quiet Place: Day One
                    </span>
                </div>

                <!-- Group 3: Popular Movie Theatres in Rajkot -->
                <div class="mb-4">
                    <span class="text-uppercase fw-semibold d-block text-white-50 mb-2" style="font-size: 12px;">POPULAR MOVIE THEATRES IN RAJKOT</span>
                    <span class="text-muted">
                        Cosmoplex Multiplex, Kalawad Road | INOX Multiplex, R-World | PVR Cinemas, Crystal Mall | Rajshree Cinema | Galaxy Cinema
                    </span>
                </div>

                <!-- Group 4: Auditoriums & Live Venues -->
                <div>
                    <span class="text-uppercase fw-semibold d-block text-white-50 mb-2" style="font-size: 12px;">LIVE EVENT VENUES IN RAJKOT</span>
                    <span class="text-muted">
                        Hemu Gadhvi Natyagruh, Tagore Road | Saurashtra Cricket Association Stadium, Khandheri | Pramukh Swami Auditorium, University Road
                    </span>
                </div>
            </div>
        </div>

        <!-- Tier 4: Logo, Social Circles & Copyright Notice (#333333) -->
        <div class="py-4 text-center" style="background-color: #333333; color: #808080; font-size: 11px;">
            <div class="bms-container">
                <!-- Centered Logo with Dividers -->
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="flex-grow-1" style="height: 1px; background-color: #4D4D4D;"></div>
                    <span class="px-3 fw-bold fs-4" style="color: #EB4E62;">
                        <i class="bi bi-ticket-perforated-fill me-1"></i>ShowSphere
                    </span>
                    <div class="flex-grow-1" style="height: 1px; background-color: #4D4D4D;"></div>
                </div>

                <!-- Social Circles -->
                <div class="d-flex justify-content-center gap-3 mb-4">
                    <a href="#" class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 36px; height: 36px; background-color: #4D4D4D; text-decoration: none;"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 36px; height: 36px; background-color: #4D4D4D; text-decoration: none;"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 36px; height: 36px; background-color: #4D4D4D; text-decoration: none;"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 36px; height: 36px; background-color: #4D4D4D; text-decoration: none;"><i class="bi bi-youtube"></i></a>
                    <a href="#" class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 36px; height: 36px; background-color: #4D4D4D; text-decoration: none;"><i class="bi bi-linkedin"></i></a>
                </div>

                <!-- Copyright & Academic Attribution -->
                <p class="mb-1 text-muted" style="max-width: 900px; margin: 0 auto; line-height: 18px;">
                    Copyright 2026 &copy; ShowSphere Academic Systems. All Rights Reserved. Engineered for college evaluation and live demonstration using C#, ASP.NET Core MVC, pure ADO.NET and Microsoft SQL Server 2022.
                </p>
                <p class="mb-0 text-muted">
                    Rajkot, Gujarat, India. Simulated payment gateway &ndash; no real credit card or financial transactions occur.
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // City selector cookie handler
        document.querySelectorAll('.city-option').forEach(function(item) {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                var city = this.getAttribute('data-city');
                document.cookie = "SelectedCity=" + encodeURIComponent(city) + "; path=/; max-age=2592000";
                var label = document.getElementById('currentCityLabel');
                if (label) label.innerText = city;
                window.location.reload();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
