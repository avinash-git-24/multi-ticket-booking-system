    <!-- 11. Popular Trending Events -->
    @if (Model.PopularEvents.Count > 0)
    {
        <section class="py-4">
            <div class="bms-container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="bms-section-title mb-0">Popular Events in Rajkot</h3>
                        <p class="text-muted small mb-0">Trending live entertainment and high-demand shows</p>
                    </div>
                    <a asp-controller="Events" asp-action="Index" class="bms-see-all">
                        See All <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>

                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
                    @foreach (var ev in Model.PopularEvents.Take(5))
                    {
                        <div class="col">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="bms-card">
                                <div class="bms-poster-wrap mb-2">
                                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                    {
                                        <img src="@ev.BannerUrl" alt="@ev.Title" loading="lazy" />
                                    }
                                    <div class="bms-rating-strip" style="background: rgba(0, 0, 0, 0.85); justify-content: flex-start;">
                                        <i class="bi bi-fire me-2 text-warning"></i>
                                        <span>Trending</span>
                                    </div>
                                    <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2" style="font-size: 10px;">@ev.Category</span>
                                </div>
                                <h6 class="bms-card-title" title="@ev.Title">@ev.Title</h6>
                                <div class="bms-card-subtitle">@ev.VenueName</div>
                                <div class="bms-card-subtext fw-semibold text-dark mt-1">₹@ev.StartingPrice.ToString("N0") onwards</div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@section Scripts {
<script>
    (function () {
        const TOTAL_REAL_SLIDES = 3;
        const REAL_START_INDEX = 2; // index 2 is real Slide 0 (Navratri)
        const REAL_END_INDEX = 4;   // index 4 is real Slide 2 (Garba)
        let currentTrackIndex = REAL_START_INDEX;
        let isTransitioning = false;
        let autoPlayTimer = null;

        const stage = document.getElementById('bmsHeroStage');
        const track = document.getElementById('bmsHeroTrack');
        const slides = document.querySelectorAll('.bms-hero-slide');
        const dots = document.querySelectorAll('.bms-hero-dot');
        const wrapper = document.querySelector('.bms-hero-wrapper');

        function getTargetX(index) {
            if (!stage || slides.length === 0) return 0;
            const firstSlide = slides[0];
            const slideStyle = window.getComputedStyle(firstSlide);
            const marginLeft = parseFloat(slideStyle.marginLeft) || 12;
            const marginRight = parseFloat(slideStyle.marginRight) || 12;
            const totalSlideWidth = firstSlide.offsetWidth + marginLeft + marginRight;
            const stageWidth = stage.offsetWidth;
            return (stageWidth / 2) - ((index + 0.5) * totalSlideWidth);
        }

        function updateCarousel(animate = true) {
            if (!track || slides.length === 0) return;
            const targetX = getTargetX(currentTrackIndex);

            if (animate) {
                track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
            } else {
                track.style.transition = 'none';
            }

            track.style.transform = `translateX(${targetX}px)`;

            // Update dots
            const realIdx = ((currentTrackIndex - REAL_START_INDEX) % TOTAL_REAL_SLIDES + TOTAL_REAL_SLIDES) % TOTAL_REAL_SLIDES;
            dots.forEach((dot, idx) => {
                if (idx === realIdx) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        }

        function handleTransitionEnd() {
            isTransitioning = false;
            // Seamless infinite loop boundary snap
            if (currentTrackIndex > REAL_END_INDEX) {
                currentTrackIndex -= TOTAL_REAL_SLIDES;
                updateCarousel(false);
                track.offsetHeight; // force reflow
            } else if (currentTrackIndex < REAL_START_INDEX) {
                currentTrackIndex += TOTAL_REAL_SLIDES;
                updateCarousel(false);
                track.offsetHeight; // force reflow
            }
        }

        if (track) {
            track.addEventListener('transitionend', handleTransitionEnd);
        }

        window.bmsSlideHero = function (direction) {
            if (isTransitioning) return;
            isTransitioning = true;
            currentTrackIndex += direction;
            updateCarousel(true);
            restartAutoPlay();
            setTimeout(() => { isTransitioning = false; }, 500);
        };

        window.bmsGoToHero = function (dotIndex) {
            if (isTransitioning) return;
            isTransitioning = true;
            currentTrackIndex = REAL_START_INDEX + dotIndex;
            updateCarousel(true);
            restartAutoPlay();
            setTimeout(() => { isTransitioning = false; }, 500);
        };

        function startAutoPlay() {
            if (autoPlayTimer) clearInterval(autoPlayTimer);
            autoPlayTimer = setInterval(() => {
                window.bmsSlideHero(1);
            }, 4500);
        }

        function stopAutoPlay() {
            if (autoPlayTimer) clearInterval(autoPlayTimer);
            autoPlayTimer = null;
        }

        function restartAutoPlay() {
            stopAutoPlay();
            startAutoPlay();
        }

        if (wrapper) {
            wrapper.addEventListener('mouseenter', stopAutoPlay);
            wrapper.addEventListener('mouseleave', startAutoPlay);
        }

        window.bmsScrollRail = function (rowId, direction) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const scrollStep = row.clientWidth * 0.85;
            const maxScroll = row.scrollWidth - row.clientWidth;

            if (direction > 0 && row.scrollLeft >= maxScroll - 15) {
                row.scrollTo({ left: 0, behavior: 'smooth' });
            } else if (direction < 0 && row.scrollLeft <= 15) {
                row.scrollTo({ left: maxScroll, behavior: 'smooth' });
            } else {
                row.scrollBy({ left: direction * scrollStep, behavior: 'smooth' });
            }
            setTimeout(() => window.bmsUpdateRailButtons(rowId), 350);
        };

        window.bmsUpdateRailButtons = function (rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const prevBtn = document.getElementById(rowId + 'Prev');
            if (prevBtn) {
                if (row.scrollLeft > 15) {
                    prevBtn.classList.remove('d-none');
                    prevBtn.style.display = 'flex';
                } else {
                    prevBtn.style.display = 'none';
                }
            }
        };

        window.addEventListener('resize', () => {
            updateCarousel(false);
        });

        function init() {
            currentTrackIndex = REAL_START_INDEX;
            updateCarousel(false);
            startAutoPlay();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
        window.addEventListener('load', () => updateCarousel(false));
    })();
</script>
}
