@model TicketBooking.Web.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Movie Tickets, Plays, Sports, Events in " + Model.SelectedCity;
}

<div class="bg-light pb-5">
    <!-- 1. Top Wide Hero Carousel (BookMyShow Style) -->
    <section class="py-3">
        <div class="container">
            <div id="bmsHeroCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#bmsHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#bmsHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#bmsHeroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner" style="max-height: 340px;">
                    <!-- Slide 1: Festival & Cultural Mega Events -->
                    <div class="carousel-item active">
                        <div class="position-relative hero-slide" style="height: 320px; background: linear-gradient(90deg, #6B1123 0%, #B81D3D 50%, #E63956 100%);">
                            <div class="container h-100 d-flex align-items-center justify-content-between p-4 p-md-5 text-white">
                                <div class="col-lg-7">
                                    <span class="badge bg-warning text-dark px-3 py-2 text-uppercase fw-bold mb-2">Live Experiences</span>
                                    <h1 class="display-5 fw-bold mb-2">Gujarat Cultural & Music Fest</h1>
                                    <p class="lead mb-4 text-white-50">Book tickets for grand live concerts, Bhavai folk natak, and stadium experiences.</p>
                                    <a asp-controller="Events" asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill fw-bold text-danger">Explore Live Events</a>
                                </div>
                                <div class="col-lg-4 text-end d-none d-lg-block">
                                    <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&auto=format&fit=crop&q=80" class="rounded-4 shadow-lg object-fit-cover" style="height: 220px; width: 320px;" alt="Festival" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2: Blockbuster Theatrical Releases -->
                    <div class="carousel-item">
                        <div class="position-relative hero-slide" style="height: 320px; background: linear-gradient(90deg, #1A1A24 0%, #2A2A38 50%, #401B24 100%);">
                            <div class="container h-100 d-flex align-items-center justify-content-between p-4 p-md-5 text-white">
                                <div class="col-lg-7">
                                    <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold mb-2">Big Screen Spectacle</span>
                                    <h1 class="display-5 fw-bold mb-2">Blockbuster Cinema in Rajkot</h1>
                                    <p class="lead mb-4 text-white-50">Singham Again, Stree 2, Kalki 2898 AD & Kasoombo now showing with Dolby Atmos sound.</p>
                                    <a asp-controller="Movies" asp-action="Index" class="btn btn-danger px-4 py-2 rounded-pill fw-bold" style="background-color: #F84464; border-color: #F84464;">Book Movie Tickets</a>
                                </div>
                                <div class="col-lg-4 text-end d-none d-lg-block">
                                    <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600&auto=format&fit=crop&q=80" class="rounded-4 shadow-lg object-fit-cover" style="height: 220px; width: 320px;" alt="Cinema" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 3: Stadium Concerts & Sports -->
                    <div class="carousel-item">
                        <div class="position-relative hero-slide" style="height: 320px; background: linear-gradient(90deg, #0A192F 0%, #172A45 50%, #303C55 100%);">
                            <div class="container h-100 d-flex align-items-center justify-content-between p-4 p-md-5 text-white">
                                <div class="col-lg-7">
                                    <span class="badge bg-info text-dark px-3 py-2 text-uppercase fw-bold mb-2">Sports & Arena Tours</span>
                                    <h1 class="display-5 fw-bold mb-2">Ranji Trophy & Arena Concerts</h1>
                                    <p class="lead mb-4 text-white-50">Saurashtra Cricket Association Stadium: Live sports matches and Arijit Singh symphony.</p>
                                    <a asp-controller="Events" asp-action="Index" asp-route-category="Sports" class="btn btn-light px-4 py-2 rounded-pill fw-bold text-dark">Reserve Stadium Passes</a>
                                </div>
                                <div class="col-lg-4 text-end d-none d-lg-block">
                                    <img src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?w=600&auto=format&fit=crop&q=80" class="rounded-4 shadow-lg object-fit-cover" style="height: 220px; width: 320px;" alt="Stadium" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#bmsHeroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon rounded-circle bg-dark p-3" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#bmsHeroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon rounded-circle bg-dark p-3" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 2. Recommended Movies (Official BookMyShow Card Grid Layout) -->
    <section class="py-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark mb-0 fs-4">Recommended Movies</h3>
                <a asp-controller="Movies" asp-action="Index" class="text-danger fw-semibold text-decoration-none small">
                    See All <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 g-md-4">
                @foreach (var movie in Model.RecommendedMovies.Take(5))
                {
                    <div class="col">
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="text-decoration-none text-dark d-block movie-poster-card">
                            <div class="position-relative rounded-3 overflow-hidden shadow-sm mb-2" style="aspect-ratio: 2/3; background-color: #1F2533;">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" class="w-100 h-100 object-fit-cover transition-transform" alt="@movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-white-50">
                                        <i class="bi bi-film fs-1"></i>
                                    </div>
                                }

                                <!-- BookMyShow Rating Strip at Bottom of Poster -->
                                <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-85 text-white px-2 py-1 small d-flex justify-content-between align-items-center" style="font-size: 0.78rem;">
                                    <span><span class="text-danger fw-bold">★</span> 8.8/10</span>
                                    <span class="text-white-50">14.2K Votes</span>
                                </div>
                            </div>
                            
                            <h6 class="fw-bold text-dark mb-1 text-truncate" title="@movie.Title">@movie.Title</h6>
                            <div class="text-muted small text-truncate" style="font-size: 0.8rem;">
                                @movie.Certificate • @movie.Genre
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">
                                @movie.Language
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 3. Endless Entertainment Stream Banner (BookMyShow Stream Strip) -->
    <section class="py-2">
        <div class="container">
            <div class="rounded-4 p-3 px-md-4 shadow-sm text-white d-flex align-items-center justify-content-between" style="background: linear-gradient(90deg, #182136 0%, #2A3656 100%);">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-danger text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-play-fill fs-5"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0 text-white">Endless Entertainment Anytime. Anywhere.</h6>
                        <span class="text-white-50 small">New releases, theatre specials, and live recordings stream in HD.</span>
                    </div>
                </div>
                <a asp-controller="Movies" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3 d-none d-md-inline-block">Explore Titles</a>
            </div>
        </div>
    </section>

    <!-- 4. The Best Of Live Events (District / BookMyShow 5 Colorful Discovery Cards) -->
    <section class="py-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark mb-0 fs-4">The Best Of Live Events</h3>
                <a asp-controller="Events" asp-action="Index" class="text-danger fw-semibold text-decoration-none small">
                    See All <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
                <!-- Card 1: Comedy Shows -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Comedy" class="text-decoration-none">
                        <div class="live-event-pill-card p-3 rounded-4 shadow-sm text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%); min-height: 160px;">
                            <div>
                                <span class="badge bg-black bg-opacity-25 px-2 py-1 mb-2">Comedy</span>
                                <h5 class="fw-bold mb-1">Comedy Shows</h5>
                                <span class="small opacity-75">Standup & Roasts</span>
                            </div>
                            <div class="text-end">
                                <span class="fs-1">🎤</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Card 2: Music Concerts -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert" class="text-decoration-none">
                        <div class="live-event-pill-card p-3 rounded-4 shadow-sm text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%); min-height: 160px;">
                            <div>
                                <span class="badge bg-black bg-opacity-25 px-2 py-1 mb-2">Music</span>
                                <h5 class="fw-bold mb-1">Music Shows</h5>
                                <span class="small opacity-75">Live Tours & Bands</span>
                            </div>
                            <div class="text-end">
                                <span class="fs-1">🎵</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Card 3: Theatre & Natak -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Theatre" class="text-decoration-none">
                        <div class="live-event-pill-card p-3 rounded-4 shadow-sm text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%); min-height: 160px;">
                            <div>
                                <span class="badge bg-black bg-opacity-25 px-2 py-1 mb-2">Drama</span>
                                <h5 class="fw-bold mb-1">Plays & Natak</h5>
                                <span class="small opacity-75">Gujarati Folk Theatre</span>
                            </div>
                            <div class="text-end">
                                <span class="fs-1">🎭</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Card 4: Sports Arena -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Sports" class="text-decoration-none">
                        <div class="live-event-pill-card p-3 rounded-4 shadow-sm text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #4F46E5 0%, #4338CA 100%); min-height: 160px;">
                            <div>
                                <span class="badge bg-black bg-opacity-25 px-2 py-1 mb-2">Stadium</span>
                                <h5 class="fw-bold mb-1">Sports Arena</h5>
                                <span class="small opacity-75">Cricket & Marathons</span>
                            </div>
                            <div class="text-end">
                                <span class="fs-1">🏏</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Card 5: Technical Workshops -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Workshop" class="text-decoration-none">
                        <div class="live-event-pill-card p-3 rounded-4 shadow-sm text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #BE123C 0%, #9F1239 100%); min-height: 160px;">
                            <div>
                                <span class="badge bg-black bg-opacity-25 px-2 py-1 mb-2">Learning</span>
                                <h5 class="fw-bold mb-1">Workshops</h5>
                                <span class="small opacity-75">Cloud, AI & Tech</span>
                            </div>
                            <div class="text-end">
                                <span class="fs-1">💻</span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. PREMIERE Section (Signature BookMyShow Dark Navy Wrapper) -->
    <section class="py-4 my-2" style="background-color: #2B3148;">
        <div class="container py-2">
            <div class="d-flex align-items-center justify-content-between mb-3 text-white">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger rounded-circle p-2"><i class="bi bi-crown-fill text-white"></i></span>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">PREMIERE</h4>
                        <span class="text-white-50 small">Watch brand new movies every Friday on big screen and stream</span>
                    </div>
                </div>
                <a asp-controller="Movies" asp-action="Index" class="text-danger fw-semibold text-decoration-none small">
                    See All <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 g-md-4">
                @foreach (var movie in Model.PremiereMovies.Take(5))
                {
                    <div class="col">
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="text-decoration-none text-white d-block movie-poster-card">
                            <div class="position-relative rounded-3 overflow-hidden shadow mb-2" style="aspect-ratio: 2/3; background-color: #1F2533;">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" class="w-100 h-100 object-fit-cover" alt="@movie.Title" loading="lazy" />
                                }
                                <div class="position-absolute bottom-0 start-0 w-100 bg-danger text-white text-center py-1 fw-bold small text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    PREMIERE
                                </div>
                            </div>
                            <h6 class="fw-bold text-white mb-1 text-truncate" title="@movie.Title">@movie.Title</h6>
                            <div class="text-white-50 small text-truncate" style="font-size: 0.78rem;">@movie.Language • @movie.Genre</div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 6. Top Music Events Carousel / Grid -->
    @if (Model.MusicEvents.Count > 0)
    {
        <section class="py-4">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="fw-bold text-dark mb-0 fs-4">Top Music Events</h3>
                        <p class="text-muted small mb-0">Live concerts and acoustic orchestra sessions</p>
                    </div>
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert" class="text-danger fw-semibold text-decoration-none small">
                        See All <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var ev in Model.MusicEvents)
                    {
                        <div class="col">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="text-decoration-none text-dark">
                                <div class="card border-0 rounded-4 shadow-sm overflow-hidden h-100 hover-lift">
                                    <div class="position-relative" style="height: 190px; background-color: #1F2533;">
                                        @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                        {
                                            <img src="@ev.BannerUrl" class="w-100 h-100 object-fit-cover" alt="@ev.Title" loading="lazy" />
                                        }
                                        <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-75 text-white small fw-semibold">
                                            <i class="bi bi-calendar-event me-1 text-warning"></i> @ev.StartDate.ToString("ddd, dd MMM • hh:mm tt")
                                        </div>
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-2 px-2 py-1">@ev.CityName</span>
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column">
                                        <h6 class="fw-bold mb-1 text-truncate" title="@ev.Title">@ev.Title</h6>
                                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @ev.VenueName</p>
                                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                            <span class="fw-bold text-dark">₹@ev.StartingPrice.ToString("N0") onwards</span>
                                            <span class="badge bg-secondary-subtle text-dark">@ev.TotalRemainingTickets left</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- 7. Standup Comedy & Cultural Theatre -->
    @if (Model.ComedyEvents.Count > 0 || Model.TheatreEvents.Count > 0)
    {
        <section class="py-4">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="fw-bold text-dark mb-0 fs-4">Laughter Therapy & Stage Plays</h3>
                        <p class="text-muted small mb-0">Unwind with standup comedy and traditional natak</p>
                    </div>
                    <a asp-controller="Events" asp-action="Index" class="text-danger fw-semibold text-decoration-none small">
                        See All <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var ev in Model.ComedyEvents.Concat(Model.TheatreEvents).Take(3))
                    {
                        <div class="col">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="text-decoration-none text-dark">
                                <div class="card border-0 rounded-4 shadow-sm overflow-hidden h-100 hover-lift">
                                    <div class="position-relative" style="height: 190px; background-color: #1F2533;">
                                        @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                        {
                                            <img src="@ev.BannerUrl" class="w-100 h-100 object-fit-cover" alt="@ev.Title" loading="lazy" />
                                        }
                                        <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2">@ev.Category</span>
                                        <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-75 text-white small fw-semibold">
                                            <i class="bi bi-calendar3 me-1 text-warning"></i> @ev.StartDate.ToString("ddd, dd MMM • hh:mm tt")
                                        </div>
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column">
                                        <h6 class="fw-bold mb-1 text-truncate" title="@ev.Title">@ev.Title</h6>
                                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @ev.VenueName</p>
                                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                            <span class="fw-bold text-dark">₹@ev.StartingPrice.ToString("N0") onwards</span>
                                            <span class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1">Book Passes</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- 8. List Your Show Partner Banner -->
    <section class="py-4">
        <div class="container">
            <div class="p-4 p-md-5 rounded-4 shadow-sm text-white d-flex flex-column flex-md-row align-items-center justify-content-between gap-3" style="background: linear-gradient(135deg, #1F2533 0%, #31374A 100%); border-left: 6px solid #F84464;">
                <div>
                    <h4 class="fw-bold mb-1 text-white">List your Show</h4>
                    <p class="text-white-50 mb-0 small">Got a live show, event, workshop or cultural performance? Partner with ShowSphere today.</p>
                </div>
                <a asp-controller="Account" asp-action="Register" class="btn btn-danger px-4 py-2 rounded-pill fw-bold" style="background-color: #F84464; border-color: #F84464;">Contact Today</a>
            </div>
        </div>
    </section>
</div>

<style>
    .movie-poster-card:hover img {
        transform: scale(1.03);
    }
    .transition-transform {
        transition: transform 0.25s ease-in-out;
    }
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .live-event-pill-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .live-event-pill-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(0,0,0,0.15) !important;
    }
</style>
