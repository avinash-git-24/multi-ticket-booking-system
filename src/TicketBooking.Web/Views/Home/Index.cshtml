@model TicketBooking.Web.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Movie Tickets, Plays, Sports, Events in " + Model.SelectedCity;
}

<div class="bms-bg-page pb-5">
    <!-- 1. Top Wide Hero Carousel (Official BookMyShow 1240px Banners with Edge Peeks) -->
    <div class="bms-hero-wrapper mb-3">
        <div class="bms-hero-stage" id="bmsHeroStage">
            <button class="bms-hero-control bms-hero-prev" type="button" aria-label="Previous Slide" onclick="bmsSlideHero(-1)">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="bms-hero-control bms-hero-next" type="button" aria-label="Next Slide" onclick="bmsSlideHero(1)">
                <i class="bi bi-chevron-right"></i>
            </button>
            <div class="bms-hero-track" id="bmsHeroTrack">
                <!-- Clone 1: Diljit (index 0) -->
                <div class="bms-hero-slide" data-index="1">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert">
                        <img src="/images/bms/hero_diljit.jpg" alt="Diljit Dosanjh Tour" />
                    </a>
                </div>
                <!-- Clone 2: Garba (index 1) -->
                <div class="bms-hero-slide" data-index="2">
                    <a asp-controller="Events" asp-action="Index">
                        <img src="/images/bms/hero_garba.jpg" alt="Aadhya Shakti Garba" />
                    </a>
                </div>
                <!-- Real 0: Navratri (index 2) -->
                <div class="bms-hero-slide" data-index="0">
                    <a asp-controller="Events" asp-action="Index">
                        <img src="/images/bms/hero_navratri.jpg" alt="Navratri Festival Rajkot" />
                    </a>
                </div>
                <!-- Real 1: Diljit (index 3) -->
                <div class="bms-hero-slide" data-index="1">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert">
                        <img src="/images/bms/hero_diljit.jpg" alt="Diljit Dosanjh Tour" />
                    </a>
                </div>
                <!-- Real 2: Garba (index 4) -->
                <div class="bms-hero-slide" data-index="2">
                    <a asp-controller="Events" asp-action="Index">
                        <img src="/images/bms/hero_garba.jpg" alt="Aadhya Shakti Garba" />
                    </a>
                </div>
                <!-- Clone 0: Navratri (index 5) -->
                <div class="bms-hero-slide" data-index="0">
                    <a asp-controller="Events" asp-action="Index">
                        <img src="/images/bms/hero_navratri.jpg" alt="Navratri Festival Rajkot" />
                    </a>
                </div>
                <!-- Clone 1: Diljit (index 6) -->
                <div class="bms-hero-slide" data-index="1">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert">
                        <img src="/images/bms/hero_diljit.jpg" alt="Diljit Dosanjh Tour" />
                    </a>
                </div>
            </div>
        </div>
        <div class="bms-hero-dots" id="bmsHeroDots">
            <span class="bms-hero-dot active" onclick="bmsGoToHero(0)"></span>
            <span class="bms-hero-dot" onclick="bmsGoToHero(1)"></span>
            <span class="bms-hero-dot" onclick="bmsGoToHero(2)"></span>
        </div>
    </div>

    <!-- 2. Recommended Movies Section (Exact 5-Column 1240px Grid) -->
    <section class="py-4">
        <div class="bms-container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="bms-section-title mb-0">Recommended Movies</h3>
                <a asp-controller="Movies" asp-action="Index" class="bms-see-all">
                    See All <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

            <div class="bms-rail-container">
                <button class="bms-rail-scroll-btn bms-rail-prev d-none d-lg-flex" id="recommendedRowPrev" type="button" aria-label="Previous movies" onclick="bmsScrollRail('recommendedRow', -1)" style="display: none;">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="bms-rail-scroll-btn bms-rail-next d-none d-lg-flex" id="recommendedRowNext" type="button" aria-label="Next movies" onclick="bmsScrollRail('recommendedRow', 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <div class="bms-rail-track" id="recommendedRow" onscroll="bmsUpdateRailButtons('recommendedRow')">
                    @foreach (var movie in Model.RecommendedMovies)
                    {
                        <div class="bms-rail-col">
                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="bms-card">
                                <div class="bms-poster-wrap mb-2">
                                    @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                    {
                                        <img src="@movie.PosterUrl" alt="@movie.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-secondary">
                                            <i class="bi bi-film fs-1"></i>
                                        </div>
                                    }

                                    <!-- BookMyShow Bottom Rating Strip -->
                                    <div class="bms-rating-strip">
                                        @if (!string.IsNullOrEmpty(movie.LikesDisplay))
                                        {
                                            <span><i class="bi bi-hand-thumbs-up-fill text-success me-1"></i>@movie.LikesDisplay</span>
                                        }
                                        else
                                        {
                                            <span><span class="text-danger fw-bold me-1">★</span>@(movie.RatingDisplay ?? "8.5/10")</span>
                                            <span class="opacity-75" style="font-size: 11px;">@(movie.VotesDisplay ?? "10K+ Votes")</span>
                                        }
                                    </div>
                                </div>
                                
                                <h6 class="bms-card-title" title="@movie.Title">@movie.Title</h6>
                                <div class="bms-card-subtitle" title="@movie.Genre">
                                    @movie.Genre
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- 3. BookMyShow STREAM Lead-In Banner (1240px x 103px) -->
    <section class="py-3">
        <div class="bms-container">
            <a asp-controller="Movies" asp-action="Index" class="d-block rounded-3 overflow-hidden shadow-sm">
                <img src="/images/bms/stream_lead_banner.png" class="w-100 object-fit-contain" alt="BookMyShow Stream Endless Entertainment" />
            </a>
        </div>
    </section>

    <!-- 4. The Best Of Live Events (5 Curated Square Category Cards) -->
    <section class="py-4">
        <div class="bms-container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="bms-section-title mb-0">The Best Of Live Events</h3>
                <a asp-controller="Events" asp-action="Index" class="bms-see-all">
                    See All <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">
                <!-- Tile 1: Comedy Shows -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Comedy" class="bms-square-tile d-block shadow-sm">
                        <img src="/images/bms/comedy_tile.png" alt="Comedy Shows" />
                    </a>
                </div>

                <!-- Tile 2: Amusement Parks -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" class="bms-square-tile d-block shadow-sm">
                        <img src="/images/bms/amusement_tile.png" alt="Amusement Parks" />
                    </a>
                </div>

                <!-- Tile 3: Theatre Shows -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Theatre" class="bms-square-tile d-block shadow-sm">
                        <img src="/images/bms/theatre_tile.png" alt="Theatre Shows" />
                    </a>
                </div>

                <!-- Tile 4: Music Shows -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert" class="bms-square-tile d-block shadow-sm">
                        <img src="/images/bms/music_tile.png" alt="Music Shows" />
                    </a>
                </div>

                <!-- Tile 5: Workshops & More -->
                <div class="col">
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Workshop" class="bms-square-tile d-block shadow-sm">
                        <img src="/images/bms/workshops_tile.png" alt="Workshops and More" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Premieres Section (Signature Dark Theme #2B3148) -->
    <section class="py-4 my-3" style="background-color: #2B3148;">
        <div class="bms-container py-2">
            <!-- Premiere Brand Promo Banner -->
            <div class="mb-4">
                <img src="/images/bms/premiere_banner.png" class="w-100 object-fit-contain rounded-2" alt="Premieres Watch New Movies at Home Every Friday" />
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3 text-white">
                <div>
                    <h3 class="fw-bold mb-0 text-white" style="font-family: 'Roboto', sans-serif;">Premieres</h3>
                    <span class="text-white-50 small">Brand new releases every Friday</span>
                </div>
                <a asp-controller="Movies" asp-action="Index" asp-route-status="Upcoming" class="bms-see-all">
                    See All <i class="bi bi-chevron-right small"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
                @foreach (var movie in Model.PremiereMovies.Take(5))
                {
                    <div class="col">
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="bms-card text-white">
                            <div class="bms-poster-wrap mb-2">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" alt="@movie.Title" loading="lazy" />
                                }
                                <div class="position-absolute bottom-0 start-0 w-100 bg-danger text-white text-center py-1 fw-bold small text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                                    PREMIERE
                                </div>
                            </div>
                            <h6 class="bms-card-title text-white" title="@movie.Title">@movie.Title</h6>
                            <div class="bms-card-subtitle text-white-50">@movie.Language</div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 6. Your Music Studio (Concerts & Live Tours Rail) -->
    @if (Model.MusicEvents.Count > 0)
    {
        <section class="py-4">
            <div class="bms-container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="bms-section-title mb-0">Your Music Studio</h3>
                        <p class="text-muted small mb-0">Live concerts, stadium tours &amp; acoustic symphony sessions</p>
                    </div>
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Concert" class="bms-see-all">
                        See All <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>

                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
                    @foreach (var ev in Model.MusicEvents.Take(5))
                    {
                        <div class="col">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="bms-card">
                                <div class="bms-poster-wrap mb-2">
                                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                    {
                                        <img src="@ev.BannerUrl" alt="@ev.Title" loading="lazy" />
                                    }
                                    <div class="bms-rating-strip" style="background: rgba(0, 0, 0, 0.85); justify-content: flex-start;">
                                        <i class="bi bi-calendar-event me-2 text-warning"></i>
                                        <span>@ev.StartDate.ToString("ddd, dd MMM")</span>
                                    </div>
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2 px-2 py-1" style="font-size: 10px;">@ev.CityName</span>
                                </div>
                                <h6 class="bms-card-title" title="@ev.Title">@ev.Title</h6>
                                <div class="bms-card-subtitle">@ev.VenueName</div>
                                <div class="bms-card-subtext fw-semibold text-dark mt-1">₹@ev.StartingPrice.ToString("N0") onwards</div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- 7. Laughter Therapy (Standup Comedy Rail) -->
    @if (Model.ComedyEvents.Count > 0)
    {
        <section class="py-4">
            <div class="bms-container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="bms-section-title mb-0">Laughter Therapy</h3>
                        <p class="text-muted small mb-0">Unwind with standup comedy and hilarious live specials</p>
                    </div>
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Comedy" class="bms-see-all">
                        See All <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>

                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
                    @foreach (var ev in Model.ComedyEvents.Take(5))
                    {
                        <div class="col">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="bms-card">
                                <div class="bms-poster-wrap mb-2">
                                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                    {
                                        <img src="@ev.BannerUrl" alt="@ev.Title" loading="lazy" />
                                    }
                                    <div class="bms-rating-strip" style="background: rgba(0, 0, 0, 0.85); justify-content: flex-start;">
                                        <i class="bi bi-calendar3 me-2 text-warning"></i>
                                        <span>@ev.StartDate.ToString("ddd, dd MMM")</span>
                                    </div>
                                    <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2" style="font-size: 10px;">Comedy</span>
                                </div>
                                <h6 class="bms-card-title" title="@ev.Title">@ev.Title</h6>
                                <div class="bms-card-subtitle">@ev.VenueName</div>
                                <div class="bms-card-subtext fw-semibold text-dark mt-1">₹@ev.StartingPrice.ToString("N0") onwards</div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- 8. The Latest Plays (Traditional Bhavai & Drama Theatre) -->
    @if (Model.TheatreEvents.Count > 0)
    {
        <section class="py-4">
            <div class="bms-container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="bms-section-title mb-0">The Latest Plays</h3>
                        <p class="text-muted small mb-0">Traditional Bhavai, cultural folk drama &amp; celebrated monologues</p>
                    </div>
                    <a asp-controller="Events" asp-action="Index" asp-route-category="Theatre" class="bms-see-all">
