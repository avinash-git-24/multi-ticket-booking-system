<!-- Architecture Highlights for Faculty Evaluation -->
<section class="section-wrapper bg-white border-top">
    <div class="container text-center">
        <h3 class="fw-bold mb-4">Enterprise Architecture Highlights</h3>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="p-3 border rounded-3 h-100">
                    <div class="display-6 text-danger mb-2">⚡</div>
                    <h6 class="fw-bold">Pure ADO.NET</h6>
                    <p class="text-muted small mb-0">Microsecond-level execution with parameterized SqlCommand. No heavy ORM overhead.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded-3 h-100">
                    <div class="display-6 text-danger mb-2">🔒</div>
                    <h6 class="fw-bold">Concurrency Safe</h6>
                    <p class="text-muted small mb-0">SQL transaction locks and filtered indexes prevent duplicate seat booking and overselling.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded-3 h-100">
                    <div class="display-6 text-danger mb-2">🛡️</div>
                    <h6 class="fw-bold">Server Authority</h6>
                    <p class="text-muted small mb-0">Browser prices and quantities are recomputed on the backend before confirming any ticket.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded-3 h-100">
                    <div class="display-6 text-danger mb-2">📋</div>
                    <h6 class="fw-bold">Audit & Provenance</h6>
                    <p class="text-muted small mb-0">Every booking and catalogue entity is tracked with verification metadata and audit logging.</p>
                </div>
            </div>
        </div>
    </div>
</section>
