@{
    ViewData["Title"] = "Movie & Event Ticket Booking in Rajkot";
}

<!-- Hero Promotional Banner Carousel -->
<section class="bg-light py-3 border-bottom">
    <div class="container">
        <div id="heroCarousel" class="carousel slide rounded-3 overflow-hidden shadow-sm" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <!-- Slide 1: Blockbuster Movies -->
                <div class="carousel-item active" style="min-height: 260px; background: linear-gradient(135deg, #1F2533 0%, #2A1B2D 50%, #B31835 100%);">
                    <div class="d-flex align-items-center justify-content-between p-4 p-md-5 text-white h-100">
                        <div class="col-md-7">
                            <span class="badge bg-danger mb-2 px-3 py-1 text-uppercase">Now in Theatres</span>
                            <h2 class="display-6 fw-bold mb-2">Blockbuster Cinema Experience</h2>
                            <p class="text-white-50 mb-3">Book tickets across Cosmoplex, INOX, and PVR in Rajkot. Choose your preferred seats in real-time.</p>
                            <a asp-controller="Movies" asp-action="Index" class="btn btn-primary-showsphere px-4 py-2">Explore Movies</a>
                        </div>
                        <div class="col-md-4 text-center d-none d-md-block">
                            <div class="p-3 bg-white bg-opacity-10 rounded-3 border border-white border-opacity-25">
                                <span class="d-block display-4 fw-bold text-danger">IMAX & 3D</span>
                                <span class="text-white-50 small">Dolby Atmos Sound Enabled</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 2: Live Concerts & Shows -->
                <div class="carousel-item" style="min-height: 260px; background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #431407 100%);">
                    <div class="d-flex align-items-center justify-content-between p-4 p-md-5 text-white h-100">
                        <div class="col-md-7">
                            <span class="badge bg-warning text-dark mb-2 px-3 py-1 text-uppercase">Live Events</span>
                            <h2 class="display-6 fw-bold mb-2">Concerts, Comedy & Sports</h2>
                            <p class="text-white-50 mb-3">Discover live entertainment at Hemu Gadhvi Natyagruh and Race Course Ground Rajkot.</p>
                            <a asp-controller="Events" asp-action="Index" class="btn btn-primary-showsphere px-4 py-2">Explore Events</a>
                        </div>
                        <div class="col-md-4 text-center d-none d-md-block">
                            <div class="p-3 bg-white bg-opacity-10 rounded-3 border border-white border-opacity-25">
                                <span class="d-block display-4 fw-bold text-warning">LIVE</span>
                                <span class="text-white-50 small">Multi-Tier Ticket Passes</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 3: Transparent College Demo -->
                <div class="carousel-item" style="min-height: 260px; background: linear-gradient(135deg, #18181B 0%, #27272A 50%, #3F3F46 100%);">
                    <div class="d-flex align-items-center justify-content-between p-4 p-md-5 text-white h-100">
                        <div class="col-md-8">
                            <span class="badge bg-info text-dark mb-2 px-3 py-1 text-uppercase">Academic Project</span>
                            <h2 class="display-6 fw-bold mb-2">Engineered with ADO.NET</h2>
                            <p class="text-white-50 mb-3">Enterprise architecture built with pure C# and SQL Server. Concurrency-safe seat locks and inventory decrement.</p>
                            <span class="badge bg-light text-dark p-2 me-2">No Entity Framework</span>
                            <span class="badge bg-light text-dark p-2">Zero Dapper</span>
                            <span class="badge bg-light text-dark p-2">Pure Parameterized SQL</span>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
</section>

<!-- Quick Category Discovery Pills -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                🎬 All Movies
            </a>
            <a asp-controller="Movies" asp-action="Index" asp-route-genre="Action" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                💥 Action
            </a>
            <a asp-controller="Movies" asp-action="Index" asp-route-genre="Drama" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                🎭 Drama
            </a>
            <a asp-controller="Movies" asp-action="Index" asp-route-language="Hindi" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                🇮🇳 Hindi
            </a>
            <a asp-controller="Movies" asp-action="Index" asp-route-language="Gujarati" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                ✨ Gujarati
            </a>
            <a asp-controller="Events" asp-action="Index" asp-route-category="Concert" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                🎵 Music Concerts
            </a>
            <a asp-controller="Events" asp-action="Index" asp-route-category="Comedy" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                🎤 Standup Comedy
            </a>
            <a asp-controller="Events" asp-action="Index" asp-route-category="Sports" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                🏏 Sports Arena
            </a>
        </div>
    </div>
</section>

